# ==============================================================================
# NEXORA - Root Environment Configuration Template
# Learn it. See it. Try it. Apply it. Master it.
# DO NOT COMMIT SENSITIVE SECRETS OR REAL CREDENTIALS
# ==============================================================================

# Backend Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL / Supabase)
DATABASE_URL=sqlite:///./nexora.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# NEVER expose SERVICE_ROLE_KEY to frontend clients
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI & LLM Provider Configuration
AI_PROVIDER=mock
LLM_API_KEY=
EMBEDDING_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Vector Database
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/chromadb

# Frontend Environment
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
