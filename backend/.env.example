# Backend Environment Configuration
PROJECT_NAME="NEXORA Backend API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS configuration (comma-separated list of origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Default to local SQLite for zero-config local development, or Supabase PostgreSQL
DATABASE_URL="sqlite:///./nexora.db"
# Example PostgreSQL / Supabase URL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Supabase Auth Configuration (for Stage 03)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-share"
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key"
JWT_ALGORITHM="HS256"

# AI Provider Configuration (mock | gemini | openai)
AI_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-pro"
EMBEDDING_API_KEY=""

# Vector Store Configuration (chroma | pgvector)
VECTOR_STORE_TYPE="chroma"
VECTOR_STORE_PATH="./data/chromadb"

# Logging Configuration
LOG_LEVEL="INFO"
